@page "/notes"

@attribute [StreamRendering]

@inject INoteService NotesService;

<PageTitle>Notes</PageTitle>

<AuthorizeView Roles="Admin,Writer">
  <Authorized>
    <a href="/note" class="btn btn-primary mb-3">Create New Note</a>
  </Authorized>
</AuthorizeView>

@if (notes is null)
{
  <p><em>Loading...</em></p>
}
else if (notes.Count == 0)
{
  <p><em>No notes available.</em></p>
}
else
{
  <table class="table">
    <thead>
      <tr>
        <th>Id</th>
        <th>Title</th>
        <th>Created</th>
        <th>User</th>
        <th></th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      @foreach (var note in notes)
      {
        <tr>
          <td>@note.Title</td>
          <td>@note.Content</td>
          <td>@note.CreatedAt</td>
          <td>@note.UserName</td>
          <td>
            <a href="/note/detail/@note.Id" class="btn btn-info btn-sm">View</a>
          </td>
            @if (note.CanEdit){
              <td>
                <a href="/note/@note.Id" class="btn btn-primary btn-sm">Edit</a>
              </td>
            }
        </tr>
      }
    </tbody>
  </table>
}

@code {
  private List<NoteResponse>? notes = new();

  protected override async Task OnInitializedAsync()
  {
    try
    {
      var result = await NotesService.GetAllNotesAsync();

      if (result is not null)
      {
        notes = result.IsSuccessfull ? result : [];
      }
    }
    catch (Exception)
    {
      throw;
    }
  }
}