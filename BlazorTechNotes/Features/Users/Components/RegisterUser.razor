@page "/register"

<PageTitle>Registro de usuario</PageTitle>

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm">
                <div class="card-body p-5">
                    <h2 class="card-title text-center mb-1">Registro de Usuario</h2>
                    <p class="text-center text-muted mb-4">Crea tu cuenta para comenzar a compartir tus ideas</p>

                    <EditForm Model="UserModel" OnValidSubmit="HandleSubmit" FormName="RegisterUserForm">
                        <DataAnnotationsValidator />
                        <ValidationSummary class="alert alert-danger" />

                        <div class="mb-3">
                            <label for="name" class="form-label">Nombre de usuario</label>
                            <InputText id="name" @bind-Value="UserModel.UserName" class="form-control"
                                placeholder="Ingresa tu nombre de usuario" />
                            <ValidationMessage For="() => UserModel.UserName" class="text-danger small d-block mt-1" />
                        </div>

                        <div class="mb-3">
                            <label for="email" class="form-label">Correo electrónico</label>
                            <InputText id="email" @bind-Value="UserModel.Email" class="form-control" type="email"
                                placeholder="correo@ejemplo.com" />
                            <ValidationMessage For="() => UserModel.Email" class="text-danger small d-block mt-1" />
                        </div>

                        <div class="mb-3">
                            <label for="password" class="form-label">Contraseña</label>
                            <InputText id="password" @bind-Value="UserModel.Password" class="form-control"
                                type="password" placeholder="Ingresa tu contraseña" />
                            <ValidationMessage For="() => UserModel.Password" class="text-danger small d-block mt-1" />
                        </div>

                        <div class="mb-4">
                            <label for="confirmPassword" class="form-label">Confirmar contraseña</label>
                            <InputText id="confirmPassword" @bind-Value="UserModel.ConfirmPassword" class="form-control"
                                type="password" placeholder="Confirma tu contraseña" />
                            <ValidationMessage For="() => UserModel.ConfirmPassword"
                                class="text-danger small d-block mt-1" />
                        </div>

                        <button type="submit" class="btn btn-primary w-100 mb-3">Registrar Usuario</button>
                        <a href="/" class="btn btn-secondary w-100">Cancelar</a>
                    </EditForm>

                    <!-- Divisor -->
                    <div class="d-flex align-items-center my-4">
                        <hr class="flex-grow-1">
                        <span class="mx-3 text-muted">O continúa con</span>
                        <hr class="flex-grow-1">
                    </div>

                    <!-- Botón de Google -->
                    <div class="mt-4">
                        <form action="/account/external-login" method="post">
                            <input type="hidden" name="provider" value="Google" />
                            <input type="hidden" name="returnUrl" value="/notes" />
                            <button type="submit" class="btn btn-outline-secondary w-100 d-flex align-items-center justify-content-center gap-2">
                                <svg width="20" height="20" viewBox="0 0 24 24">
                                    <path fill="#4285F4"
                                        d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" />
                                    <path fill="#34A853"
                                        d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" />
                                    <path fill="#FBBC05"
                                        d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" />
                                    <path fill="#EA4335"
                                        d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" />
                                </svg>
                                Registrarse con Google
                            </button>
                        </form>
                    </div>

                    @if (!string.IsNullOrEmpty(errorMessage))
                    {
                        <div class="alert alert-danger alert-dismissible fade show mt-3" role="alert">
                            <i class="bi bi-exclamation-circle me-2"></i>
                            <strong>Error:</strong> @errorMessage
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>