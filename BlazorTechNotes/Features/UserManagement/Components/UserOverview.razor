@page "/user-overview"

@using BlazorTechNotes.Application.Features.Users.Abstractions
@using BlazorTechNotes.Application.Features.Users.Responses
@using Microsoft.AspNetCore.Components.QuickGrid

@inject IUserService UserService;
@rendermode @(new InteractiveServerRenderMode())
@attribute [Authorize(Roles = "Admin")]

<PageTitle>Users</PageTitle>

<div class="d-flex flex-column flex-sm-row align-items-sm-center justify-content-between gap-2 mb-4">
  <div>
    <h1 class="h3 mb-1">Users</h1>
    <p class="text-body-secondary mb-0">Manage registered users and their roles.</p>
  </div>
  @if (users is not null)
  {
    <span class="badge text-bg-primary rounded-pill align-self-start align-self-sm-center">
      @users.Count user@(users.Count == 1 ? "" : "s")
    </span>
  }
</div>

@if (users is null)
{
  <div class="d-flex align-items-center gap-2 text-body-secondary" role="status">
    <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
    <span>Loading users...</span>
  </div>
}
else if (users.Count == 0)
{
  <div class="alert alert-light border mb-0" role="status">
    No users found.
  </div>
}
else
{
  <div class="card border-0 shadow-sm">
    <div class="card-header bg-body d-flex align-items-center justify-content-between py-3">
      <h2 class="h6 mb-0">Registered users</h2>
    </div>
    <div class="table-responsive">
      <QuickGrid Class="table table-striped table-hover align-middle mb-0" Items="@users.AsQueryable()">
        <PropertyColumn Property="@(u => u.UserName)" Sortable="true" Title="User Name" />
        <PropertyColumn Property="@(u => u.Email)" Sortable="true" Title="Email" />
        <PropertyColumn Property="@(u => u.Roles)" Title="Roles" />
        <TemplateColumn Title="Manage Roles" Class="text-nowrap">
          <div class="d-flex justify-content-center align-items-center">
            <button type="button" class="btn btn-primary btn-sm" @onclick="() => OpenRolesModal(context.Id, context.UserName)">
              Edit
            </button>
          </div>
        </TemplateColumn>
      </QuickGrid>
    </div>
  </div>
}

<UserRolesModal 
  ShowRolesModal="@showRolesModal" 
  UserId="@selectedUserId" 
  UserName="@selectedUserName" 
  OnClose="CloseRolesModal" 
/>

@code {
  private List<UserResponse>? users;
  
  private bool showRolesModal = false;
  private string selectedUserId = string.Empty;
  private string selectedUserName = string.Empty;

  protected override async Task OnInitializedAsync()
  {
    await LoadUsersAsync();
  }

  private void OpenRolesModal(string userId, string userName)
  {
    selectedUserId = userId;
    selectedUserName = userName;
    showRolesModal = true;
  }

  private async Task CloseRolesModal()
  {
    showRolesModal = false;
    selectedUserId = string.Empty;
    selectedUserName = string.Empty;

    await LoadUsersAsync(); // Refresh the user list after closing the modal
    StateHasChanged(); // Notify the component to re-render
  }

  private async Task LoadUsersAsync()
  {
    var result = await UserService.GetAllUsersAsync();

    if (result.IsSuccess && result.Value is not null)
    {
      users = result.Value;
    }
    else
    {
      users = new();
    }
  }
}
