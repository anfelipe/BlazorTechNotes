<Router AppAssembly="typeof(Program).Assembly" NotFoundPage="typeof(Shared.NotFound)">
    <Found Context="routeData">
        <AuthorizeRouteView RouteData="routeData" DefaultLayout="typeof(Shared.NoteLayout)">
            <NotAuthorized>
                <div class="min-vh-100 d-flex align-items-center justify-content-center bg-light py-5">
                    <div class="card shadow-sm" style="max-width:420px; width:100%;">
                        <div class="card-body text-center">
                            <!-- Icono de acceso denegado -->
                            <svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" fill="none" stroke="currentColor" class="mb-3 text-danger" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                    d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
                            </svg>

                            <h2 class="h4 fw-bold mb-2">Acceso Denegado</h2>
                            <p class="text-muted mb-4">No tienes permisos para acceder a esta página.<br/>Por favor, inicia sesión para continuar.</p>

                            <div class="d-grid gap-2">
                                <AuthorizeView>
                                    <NotAuthorized Context="authContext">
                                    <a href="/login" class="btn btn-primary w-100">Iniciar Sesión</a>
                                    </NotAuthorized>
                                </AuthorizeView>
                                <a href="/notes" class="btn btn-outline-secondary w-100">Volver a notas</a>
                            </div>
                        </div>
                    </div>
                </div>
            </NotAuthorized>
        </AuthorizeRouteView>
        <FocusOnNavigate RouteData="routeData" Selector="h1" />
    </Found>
</Router>